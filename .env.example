# Copy to .env (never commit .env).
# Local dev: keep LLM_MODE=mock. On OpenShift these are set with `oc set env`.
LLM_MODE=mock
# On OpenShift we use the organizers' model (namespace my-first-model, reachable only inside the cluster):
#   http://llama-32-3b-instruct-predictor.my-first-model.svc.cluster.local:8080/v1
LLM_BASE_URL=
# Token only if the model has token auth on. The organizers' model has none: leave empty.
LLM_API_KEY=
# Model name as vLLM serves it (GET <LLM_BASE_URL>/models). Organizers' model: llama-32-3b-instruct
LLM_MODEL=cfo-llm
# Max time for one model call, and max total model time for one API request (the conference makes 5 calls)
LLM_TIMEOUT_MS=20000
LLM_BUDGET_MS=22000
PORT=8080
