# Copy to .env (never commit .env).
# Local dev: keep LLM_MODE=mock. On OpenShift these are set with `oc set env`.
LLM_MODE=mock
# e.g. https://cfo-llm-<project>.apps.<cluster>/v1  or  http://cfo-llm-predictor.<project>.svc.cluster.local:8080/v1
LLM_BASE_URL=
# RHOAI model token if "Require token authentication" is on, otherwise leave empty
LLM_API_KEY=
# Name of the model deployment in RHOAI (vLLM serves it under this name)
LLM_MODEL=cfo-llm
LLM_TIMEOUT_MS=30000
PORT=8080
