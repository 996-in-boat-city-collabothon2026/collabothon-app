# Copy to .env (never commit .env).
# Local dev: keep LLM_MODE=mock. On OpenShift these are set with `oc set env`.
LLM_MODE=mock
# On OpenShift the model is reachable only inside the cluster:
#   http://llama-31-8b-instruct-predictor.cfo-llm.svc.cluster.local:8080/v1  (our Llama 3.1 8B, live since 21 Nov)
LLM_BASE_URL=
# Token only if the model has token auth on. The organizers' model has none: leave empty.
LLM_API_KEY=
# Model name as vLLM serves it (GET <LLM_BASE_URL>/models). Live model: llama-31-8b-instruct
LLM_MODEL=cfo-llm
# Max time for one model call, and max total model time for one API request (the conference makes 5 calls)
LLM_TIMEOUT_MS=20000
LLM_BUDGET_MS=22000
PORT=8080
